# {{ ansible_managed }}
# Source: lowones/homelab -> ansible/tabcolor
# Marks this host so terminal tabs can be told apart. Do not edit in place.
#   every terminal: tab/window title "<coloured square> <host>"   (OSC 2)
#   iTerm2 only:    the real tab colour                           (OSC 6)
# The title marker is what Ghostty and other terminals without per-tab colour
# can show; it also travels over ssh like the colour does.

# Interactive shells only.
case $- in *i*) ;; *) return ;; esac

# Never emit into a pipe or a command substitution.
[ -t 1 ] || return

# Consoles that cannot show a title would print the escape codes as garbage.
case "${TERM:-dumb}" in linux|dumb|vt100|vt220) return ;; esac

if [ "$(id -u)" = "0" ]; then
    TC_R={{ tab_color_root.r }}; TC_G={{ tab_color_root.g }}; TC_B={{ tab_color_root.b }}
    TC_MARK="{{ tab_emoji_root }} root@{{ inventory_hostname }}"
    TC_UC="1;38;5;{{ 16 + 36*((tab_color_root.r*5+127)//255) + 6*((tab_color_root.g*5+127)//255) + ((tab_color_root.b*5+127)//255) }}"
else
    TC_R={{ tab_color.r }}; TC_G={{ tab_color.g }}; TC_B={{ tab_color.b }}
    TC_MARK="{{ tab_emoji }} {{ inventory_hostname }}"
    TC_UC="1;38;5;{{ 16 + 36*((tab_color.r*5+127)//255) + 6*((tab_color.g*5+127)//255) + ((tab_color.b*5+127)//255) }}"
fi
TC_PATH="{{ tab_path_sgr }}"

# tmux swallows OSC unless wrapped in a DCS passthrough envelope, with every
# inner ESC doubled. Requires 'allow-passthrough on' for tmux >= 3.3.
_tab_seq() {
    if [ -n "${TMUX:-}" ]; then
        printf '\033Ptmux;\033\033]%s\a\033\\' "$1"
    else
        printf '\033]%s\a' "$1"
    fi
}

# Colour user@host with this host's colour. Swaps the green block of the usual Debian-style
# PS1 in place (keeps chroot prefix and anything else); if there is none, sets the standard
# user@host:path prompt. The path stays blue unless tab_path_sgr says otherwise.
_tc_prompt() {
    [ -n "${PS1:-}" ] || return 0
    local g='\[\033[01;32m\]' b='\[\033[01;34m\]' nu nb
    nu="\\[\\033[${TC_UC}m\\]"
    nb="\\[\\033[${TC_PATH}m\\]"
    case "$PS1" in
        *"$g"*)
            PS1="${PS1//"$g"/"$nu"}"
            [ "$TC_PATH" = "01;34" ] || PS1="${PS1//"$b"/"$nb"}"
            ;;
        *)
            PS1="\${debian_chroot:+(\$debian_chroot)}${nu}\\u@\\h\\[\\033[00m\\]:${nb}\\w\\[\\033[00m\\]\\\$ "
            ;;
    esac
}

_tabcolor() {
    # Debian/Ubuntu's default PS1 sets its own title ("user@host: dir") AFTER
    # PROMPT_COMMAND runs, which would overwrite the marker. Appending the
    # sequence to PS1 puts ours last. Done once, at the first prompt, so it
    # runs after .bashrc has set PS1.
    if [ -z "${_TC_PS1_DONE:-}" ]; then
        _TC_PS1_DONE=1
        _tc_prompt
        if [ -n "${PS1:-}" ]; then
            PS1="${PS1}\[$(_tab_seq "2;${TC_MARK}")\]"
        fi
    fi
    _tab_seq "2;${TC_MARK}"

    # Real tab colour: iTerm2 only (proprietary sequence).
    [ "${LC_TERMINAL:-}" = "iTerm2" ] || return 0
    _tab_seq "6;1;bg;red;brightness;$TC_R"
    _tab_seq "6;1;bg;green;brightness;$TC_G"
    _tab_seq "6;1;bg;blue;brightness;$TC_B"
}

# Repaint before every prompt rather than once on connect. This is what makes
# nested hops self-healing: exiting an inner session repaints the outer host's
# marker automatically, where a reset-on-exit would clear to default instead.
# Guarded so nested sourcing (sudo -i) can't stack duplicates.
case "${PROMPT_COMMAND:-}" in
    *_tabcolor*) ;;
    *) PROMPT_COMMAND="_tabcolor${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac
