#!/bin/bash
# tv - command line for the RV TV service.
# On the mini it reads tv.env next to this script. From another machine set TV_URL and TV_TOKEN:
#   export TV_URL=http://neverland:8780 TV_TOKEN=...
# Usage: tv on | off | status | inputs | apps | input HDMI_1 | volume 15|up|down
#        tv mute on|off|toggle | app youtube.leanback.v4
#        tv display open|close|state | tv sheet | tv place "Moab, Utah" | tv place auto
#        tv nettest [--duration 60]   10-minute network test for video calls (see README)
#        tv prepmove --dry-run | --resume   what Tools > Prep for move would quit; load the stopped agents again
set -euo pipefail
ENVF="${TV_ENV:-$(cd "$(dirname "$0")" && pwd)/tv.env}"
if [ -f "$ENVF" ]; then set -a; . "$ENVF"; set +a; fi
if [ "${1:-}" = prepmove ]; then shift; exec python3 "$(cd "$(dirname "$0")" && pwd)/prepmove.py" "$@"; fi   # runs locally, needs no token
if [ "${1:-}" = nettest ]; then shift; exec python3 "$(cd "$(dirname "$0")" && pwd)/nettest.py" "$@"; fi   # runs locally, needs no token
URL="${TV_URL:-http://${TV_BIND:-127.0.0.1}:${TV_SERVER_PORT:-8780}}"
TOKEN="${TV_TOKEN:?TV_TOKEN not set (no tv.env found)}"

req() { curl -fsS --max-time 150 -X "$1" -H "Authorization: Bearer $TOKEN" "$URL$2"; echo; }

case "${1:-}" in
  on)      req POST /power/on ;;
  off)     req POST /power/off ;;
  status)  req GET /status ;;
  inputs)  req GET /inputs ;;
  apps)    req GET /apps ;;
  input)   req POST "/input/${2:?input id, e.g. HDMI_1}" ;;
  volume)  req POST "/volume/${2:?number 0-100, or up/down}" ;;
  mute)    if [ "${2:-}" = toggle ]; then   # flip the current state (what a mute key wants)
             cur=$(curl -fsS --max-time 20 -H "Authorization: Bearer $TOKEN" "$URL/status" | python3 -c 'import sys,json; print("off" if json.load(sys.stdin).get("muted") else "on")')
             req POST "/mute/$cur"
           else req POST "/mute/${2:?on, off or toggle}"; fi ;;
  app)     req POST "/app/${2:?app id}" ;;
  sheet)   req POST "/display/open?page=sheet" ;;
  display) case "${2:-}" in open|close) req POST "/display/$2" ;; state) req GET /display/state ;; *) echo "usage: tv display open|close|state"; exit 1 ;; esac ;;
  place)   [ "${2:-}" = auto ] && { req POST "/display/location?auto=true"; exit; }
           req POST "/display/location?place=$(python3 -c 'import sys,urllib.parse as u;print(u.quote(sys.argv[1]))' "${2:?e.g. \"Moab, Utah\"}")" ;;
  *) sed -n '2,9p' "$0"; exit 1 ;;
esac
